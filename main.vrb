\frametitle{The rising noise floor}
\begin{columns}[c]
    \begin{column}{0.4\textwidth}
      \begin{tikzpicture}
        \node[box, draw=fzjgray50, fill=fzjgray!60, align=left, font=\scriptsize\ttfamily, text width=5.0cm] {%
          {\color{fzjred}\# before: same seed on every rank}\\
          {\color{fzjred}cp.random.seed(152)}\\[4pt]
          {\color{fzjgreen!50!black}\# fix: different seed per rank}\\
          {\color{fzjgreen!50!black}cp.random.seed(152 + 100*rank)}};
      \end{tikzpicture}
      \begin{itemize}\scriptsize
        \item Every GPU draws its $N/W$ particles from the \hl{same seed}
          $\to$ very similar particles on all ranks
        \item Effectively only $\approx N/W$ independent particles
          $\to$ noise floor \hl{grows with the GPU count}
        \item One seed per rank $\to$ the noise floor no longer depends on $W$
      \end{itemize}
    \end{column}
    \begin{column}{0.58\textwidth}
      \centering
      %\only<1>{\includegraphics[trim=0 140 0 0, clip, width=0.8\textwidth]{seed_noise}\\[2pt]}
      \adjustbox{trim=0 0 {.75\width} 0, clip, width=0.45\textwidth}{\includegraphics{figures/152326}}
      \adjustbox{trim={.75\width} 0 0 0, clip, width=0.45\textwidth}{\includegraphics{figures/152326}}

      {\scriptsize 1 GPU vs.\ 8 GPUs, \textcolor{fzjred}{before} (same seed)}\\[6pt]
      \adjustbox{trim=0 0 {.6667\width} 0, clip, width=0.45\textwidth}{\includegraphics{figures/P_8_to_32_6pt8M_particles_float32_different_RNG}}
      \adjustbox{trim={.6667\width} 0 0 0, clip, width=0.45\textwidth}{\includegraphics{figures/P_8_to_32_6pt8M_particles_float32_different_RNG}}

      {\scriptsize 1 vs.\ 8 GPUs, \textcolor{fzjblue}{after} (seed + 100$\cdot$rank)}
    \end{column}
  \end{columns}
